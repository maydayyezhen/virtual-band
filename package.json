{
  "name": "virtual-band-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:calibration": "vite --open /calibration.html",
    "dev:mix": "vite --open /mix.html",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "mix:verify": "node --experimental-strip-types scripts/verify-audio-mix.mjs",
    "calibration:verify": "node --experimental-strip-types scripts/verify-audio-calibration.mjs",
    "layout:verify": "node --experimental-strip-types scripts/verify-layout-document.mjs",
    "sf2:fetch": "node scripts/fetch-fluidr3-sf2.mjs",
    "sf2:verify": "node --experimental-strip-types scripts/verify-sf2-parser.mjs",
    "midi:verify": "node --experimental-transform-types scripts/verify-midi-visuals.mjs",
    "midi:routing:verify": "node --experimental-strip-types scripts/verify-midi-routing.mjs",
    "midi:routing:browser": "node scripts/verify-midi-routing-browser.mjs",
    "midi:browser": "node scripts/verify-midi-browser.mjs",
    "live:browser": "node scripts/verify-live-browser.mjs",
    "camera:browser": "node scripts/verify-camera-browser.mjs",
    "camera:performance:verify": "node scripts/verify-camera-performance.mjs",
    "video:export": "node scripts/export-bohemian.mjs",
    "stage:browser": "node scripts/verify-stage-layout-browser.mjs",
    "lighting:verify": "node --experimental-transform-types scripts/verify-lighting.mjs",
    "lighting:browser": "node scripts/verify-lighting-browser.mjs",
    "screens:verify": "node --experimental-transform-types scripts/verify-screens.mjs",
    "screens:browser": "node scripts/verify-screens-browser.mjs",
    "theatre:browser": "node scripts/verify-theatre-browser.mjs",
    "formation:browser": "node scripts/verify-formation-browser.mjs",
    "piano:browser": "node scripts/verify-piano-browser.mjs",
    "saxophone:browser": "node scripts/verify-saxophone-browser.mjs",
    "cello:browser": "node scripts/verify-cello-study-browser.mjs",
    "cello:integration:browser": "node scripts/verify-cello-integration-browser.mjs",
    "cello:vibration:browser": "node scripts/verify-cello-vibration-browser.mjs"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "spessasynth_lib": "4.3.14",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
